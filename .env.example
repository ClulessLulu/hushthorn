# Option B (local dev only): direct browser access to the Claude API.
# Copy this file to .env and fill in your key. NEVER commit .env.
# Option A (recommended) is to use your proxy server instead — see README.
VITE_ANTHROPIC_API_KEY=

# Show "Continue with Google" on the sign-in page. Leave unset/false until the
# Google provider is enabled in that environment's Supabase project. Build-time:
# changing it in Vercel requires a redeploy.
VITE_ENABLE_GOOGLE_AUTH=false
